# Supabase PostgreSQL connection string (Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres
# Supabase project API URL and server-only Storage key (never expose to browser)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret
SUPABASE_STORAGE_BUCKET=nasim-booking-files
PG_POOL_MAX=5
NODE_ENV=production
